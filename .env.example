# Database Configuration
API_DATABASE_URL=sqlite:///./retail_analytics.db
API_DEFAULT_CONFIG_PATH=configs/default.yaml

# CORS (Allow the React frontend to communicate with the API)
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Security 
API_API_KEY=

# Limits
API_MAX_MJPEG_CLIENTS=5
API_WS_MAX_CLIENTS=50

# Data Retention 
API_RETENTION_DAYS=30

# Demo Mode 
API_DEMO_MODE=false

# Logging
API_LOG_LEVEL=INFO